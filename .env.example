# Copy to .env in the project root or backend/.env. Never commit real values.

# App
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Twilio Verify (mobile OTP). Leave blank to show the setup state in the UI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# OpenAI (Money Coach). Leave blank to use the labeled limited demo fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Angel One SmartAPI — read-only portfolio/quotes. Do not put passwords in the FinCoach UI.
# Use tokens from SmartAPI (JWT + optional refresh). Never commit real tokens.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_JWT_TOKEN=
ANGEL_ONE_REFRESH_TOKEN=
ANGEL_ONE_FEED_TOKEN=

# CoinGecko is public; optional demo key if you have one.
COINGECKO_API_KEY=

# Optional gold/silver source (gold-api.com public endpoints used by default).
METALS_API_BASE=https://api.gold-api.com
